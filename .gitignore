# Large media files — keep locally, do not commit
# (originals live in media-src/; web-optimised copies in public/videos are
# committed — see the exception below)
media-src/
*.mp4
*.MP4
*.mov
*.MOV
*.MOV
*.heic
*.HEIC
src/assets/Work/*.mov
src/assets/Work/*.MOV

# ...except assets imported directly by source code, which must ship in the repo
!src/assets/vendor-pro/HomeVend.mp4

# Web-optimised demo videos (H.264, compressed) are deployed.
!public/videos/*.mp4
